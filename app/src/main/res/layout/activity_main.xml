<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    tools:context=".MainActivity">

    <!-- ============ TOP CENTER: CLOCK + DATE ============ -->
    <LinearLayout
        android:id="@+id/clockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:shadowColor="#80E8A15C"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16"
            android:textColor="@color/optios_text_primary"
            android:textSize="58sp"
            tools:text="22:09" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.72"
            android:fontFamily="serif"
            android:textColor="@color/optios_text_primary"
            android:textSize="15sp"
            tools:text="Tuesday, Oct 27" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/optios_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="32°C" />

        <TextView
            android:id="@+id/weatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:textColor="@color/optios_text_primary"
            android:textSize="12sp"
            android:text="@string/weather_placeholder" />
    </LinearLayout>

    <!-- ============ USAGE WIDGET CARD (glass, under the clock) ============ -->
    <LinearLayout
        android:id="@+id/statusWidget"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"
        app:layout_constraintTop_toBottomOf="@id/clockBlock">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:letterSpacing="0.12"
            android:text="@string/widget_usage"
            android:textColor="@color/optios_text_primary"
            android:textSize="11sp" />

        <com.optios.launcher.status.StatusDonutsView
            android:id="@+id/donutsView"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ============ MUSIC "CD CARD" (appears when a song plays) ============ -->
    <FrameLayout
        android:id="@+id/mediaCard"
        android:layout_width="420dp"
        android:layout_height="132dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusWidget">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/mediaArt"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/optios_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Song title" />

                <TextView
                    android:id="@+id/mediaArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/optios_text_primary"
                    android:textSize="14sp"
                    tools:text="Artist" />

                <ProgressBar
                    android:id="@+id/mediaProgress"
                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/optios_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ HERO TILES (smaller, refined) ============ -->
    <LinearLayout
        android:id="@+id/tileRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/dockRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clockBlock">

        <LinearLayout
            android:id="@+id/tileYouTube"
            style="@style/GlassTile">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/tile_youtube"
                android:src="@drawable/ic_tile_youtube" />

            <TextView
                style="@style/GlassTileLabel"
                android:text="@string/tile_youtube" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileCinemana"
            style="@style/GlassTile">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/tile_cinemana"
                android:src="@drawable/ic_tile_cinemana" />

            <TextView
                style="@style/GlassTileLabel"
                android:text="@string/tile_cinemana" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ DOCK ============ -->
    <LinearLayout
        android:id="@+id/dockRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_dock_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/dockApps"
            style="@style/DockItem"
            android:text="@string/dock_apps" />

        <View style="@style/DockDivider" />

        <TextView
            android:id="@+id/dockControls"
            style="@style/DockItem"
            android:text="@string/dock_controls" />

        <View style="@style/DockDivider" />

        <TextView
            android:id="@+id/dockSettings"
            style="@style/DockItem"
            android:text="@string/dock_settings" />
    </LinearLayout>

    <!-- ============ CONTROL CENTER (slide-up glass panel, from the remote) ============ -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:text="@string/panel_title"
            android:textColor="@color/optios_text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPanelSleep"
                style="@style/PanelButton"
                android:text="@string/panel_sleep" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sleep / privacy-black overlay (full, opaque, above everything) -->
    <View
        android:id="@+id/sleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.97"
        android:visibility="gone"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
