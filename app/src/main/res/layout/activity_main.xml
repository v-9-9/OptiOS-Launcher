<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    tools:context=".MainActivity">

    <!-- Rotating pairing code (under the weather glass box, top-right) -->
    <TextView
        android:id="@+id/codePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_card"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/optios_accent"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/weatherBlock"
        tools:text="418293"
        tools:visibility="visible" />

    <!-- LAN relay incoming notification card (glass, top-center) -->
    <LinearLayout
        android:id="@+id/relayCard"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/relayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/optios_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="YouTube" />

        <TextView
            android:id="@+id/relayBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/optios_text_primary"
            android:textSize="14sp"
            tools:text="New video: How X works" />
    </LinearLayout>

    <!-- ============ TOP: CLOCK LEFT / WEATHER RIGHT ============ -->
    <LinearLayout
        android:id="@+id/clockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:textColor="@color/optios_text_primary"
            android:textSize="60sp"
            tools:text="14:52" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.75"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/optios_text_primary"
            android:textSize="14sp"
            tools:text="Monday, Oct 27" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/weatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/optios_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="32°C" />

        <TextView
            android:id="@+id/weatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:textColor="@color/optios_text_primary"
            android:textSize="12sp"
            android:text="@string/weather_placeholder" />
    </LinearLayout>

    <!-- ============ MUSIC "CD CARD" (appears when a song plays) ============ -->
    <FrameLayout
        android:id="@+id/mediaCard"
        android:layout_width="420dp"
        android:layout_height="132dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_glass_card"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/clockBlock"
        app:layout_constraintTop_toBottomOf="@id/clockBlock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/mediaArt"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mediaTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/optios_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Song title" />

                <TextView
                    android:id="@+id/mediaArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/optios_text_primary"
                    android:textSize="14sp"
                    tools:text="Artist" />

                <ProgressBar
                    android:id="@+id/mediaProgress"
                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/optios_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ HERO TILES (smaller, refined) ============ -->
    <LinearLayout
        android:id="@+id/tileRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/dockRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clockBlock">

        <LinearLayout
            android:id="@+id/tileYouTube"
            style="@style/GlassTile">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/tile_youtube"
                android:src="@drawable/ic_tile_youtube" />

            <TextView
                style="@style/GlassTileLabel"
                android:text="@string/tile_youtube" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileCinemana"
            style="@style/GlassTile">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/tile_cinemana"
                android:src="@drawable/ic_tile_cinemana" />

            <TextView
                style="@style/GlassTileLabel"
                android:text="@string/tile_cinemana" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ DOCK ============ -->
    <LinearLayout
        android:id="@+id/dockRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/dockApps"
            style="@style/DockItem"
            android:text="@string/dock_apps" />

        <TextView
            android:id="@+id/dockControls"
            style="@style/DockItem"
            android:text="@string/dock_controls" />

        <TextView
            android:id="@+id/dockSettings"
            style="@style/DockItem"
            android:text="@string/dock_settings" />
    </LinearLayout>

    <!-- Sleep / privacy-black overlay (full, opaque, above everything) -->
    <View
        android:id="@+id/sleepOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.97"
        android:visibility="gone"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
