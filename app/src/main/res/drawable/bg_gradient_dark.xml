<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1B1512"
                android:centerColor="#221A14"
                android:endColor="#120D0A"
                android:type="linear" />
        </shape>
    </item>
    <!-- Warm lamp-glow haze top-center -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#2EE8A15C"
                android:endColor="#00E8A15C"
                android:type="radial"
                android:centerX="0.72"
                android:centerY="0.22"
                android:gradientRadius="65%p" />
        </shape>
    </item>
</layer-list>
