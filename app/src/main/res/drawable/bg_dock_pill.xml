<?xml version="1.0" encoding="utf-8"?>
<!-- Larger-rounded glass pill for the dock -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2E3A4256"
        android:centerColor="#1A2A3344"
        android:endColor="#12223240"
        android:type="linear" />
